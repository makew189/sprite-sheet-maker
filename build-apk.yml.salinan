name: Build APK

on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v5
        with:
          gradle-version: '8.7'

      - name: Terima lisensi Android SDK
        run: yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true

      - name: Build APK debug
        run: gradle assembleDebug --no-daemon --stacktrace

      - name: Ganti nama APK
        run: cp app/build/outputs/apk/debug/app-debug.apk SpriteSheetMaker-debug.apk

      - uses: actions/upload-artifact@v7
        with:
          name: SpriteSheetMaker-debug-apk
          path: SpriteSheetMaker-debug.apk
          if-no-files-found: error
          retention-days: 30

      - name: Lampirkan APK ke Release (hanya saat tag v*)
        if: startsWith(github.ref, 'refs/tags/v')
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          TAG="${GITHUB_REF_NAME}"
          if gh release view "$TAG" >/dev/null 2>&1; then
            gh release upload "$TAG" SpriteSheetMaker-debug.apk --clobber
          else
            gh release create "$TAG" SpriteSheetMaker-debug.apk --title "Sprite Sheet Maker $TAG" --generate-notes
          fi
